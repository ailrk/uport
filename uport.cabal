cabal-version:      3.0
name:               uport
version:            0.1.0.0

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:
      base        >=4.16 && <5
    , bytestring
    , text
    , aeson
    , directory
    , filepath
    , string-interpolate


-- 1. Shared library containing data models, S3 logic, etc.
library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Storage
                    , Types
    build-depends:    amazonka
                    , amazonka-s3
                    , time
                    , resourcet
                    , http-conduit


executable uport-server
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   uport-server
    build-depends:    uport
                    , scotty
                    , uuid
                    , stm
                    , containers
                    , http-types
                    , wai-extra
